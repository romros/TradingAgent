  "indicator_contract": {
    "atr": {
      "period": 14,
      "method": "simple_moving_average_true_range",
      "true_range": "max(high-low,abs(high-prev_close),abs(low-prev_close))"
    },
    "channel_breakout": {
      "long": "endpoint_close > maximum_high_of_indicator_period_bars_strictly_before_endpoint",
      "short": "endpoint_close < minimum_low_of_indicator_period_bars_strictly_before_endpoint",
      "equality_triggers": false
    },
    "time_series_momentum": {
      "roc_pct": "100*(endpoint_close/close_indicator_period_bars_before_endpoint-1)",
      "long": "roc_pct > roc_threshold_pct",
      "short": "roc_pct < -roc_threshold_pct",
      "ambiguous_both_signal": "skip"
    },
    "volatility_compression_breakout": {
      "normalized_atr": "atr14/close",
      "compression_threshold": "linear_percentile_of_prior_compression_lookback_normalized_atr_values_excluding_endpoint",
      "compression": "endpoint_normalized_atr <= compression_threshold",
      "breakout": "same_prior_channel_and_strict_comparison_as_channel_breakout"
    }
  },
  "position_contract": {
    "maximum_concurrent_positions_per_branch": 1,
    "opposite_signal_while_open": "ignore",
    "entry_price": "next_bar_open",
    "stop_distance": "decision_endpoint_atr14*atr_stop_multiple",
    "stop_is_fixed_after_entry": true,
    "stop_fill": "exact_stop_price_without_gap_improvement",
    "time_exit": "close_of_exit_after_bars_th_bar_including_entry_bar",
    "same_bar_priority": [
      "stop",
      "time_exit"
    ],
    "unfinished_position_at_train_boundary": "exclude",
    "compounding_during_hypothesis_screen": false
  },
  "direction_contract": {
    "long": "only_long_signals",
    "short": "only_short_signals",
    "both": "long_and_short_signals_but_skip_if_both_true_on_same_decision"
  },
  "economics_contract": {
