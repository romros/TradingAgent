{
  "schema_version": 4,
  "methodology_id": "alquimia-v4-coverage-before-performance",
  "ownership": "TradingAgent/Alquimia",
  "capital_usdc": 200,
  "principles": {
    "sq_role": "candidate_generator_only",
    "legacy_configs": "format_scaffold_only",
    "legacy_quantitative_evidence": "forbidden_for_promotion",
    "holdout_policy": "sealed_until_final_gate",
    "live_policy": "explicit_human_authorization",
    "coverage_policy": "historical_coverage_before_any_performance"
  },
  "stages": [
    "market_preflight", "hypothesis_screen", "sq_generation",
    "temporal_validation", "robustness", "small_account_economics",
    "final_holdout_validation", "python_translation", "parity", "paper"
  ],
  "market_preflight": {
    "minimum_overall_observation_coverage_ratio": 0.9,
    "minimum_each_period_coverage_ratio": 0.8,
    "minimum_proxy_candle_coverage_pct": 95,
    "minimum_return_correlation": 0.99,
    "performance_accessed": false,
    "required_economics": ["fee", "spread", "slippage", "rollover", "minimum_notional", "venue_max_leverage"]
  },
  "temporal_split": {
    "train_pct": 50,
    "validation_pct": 20,
    "oos_pct": 20,
    "final_holdout_pct": 10,
    "embargo_bars": 10
  },
  "hypothesis_screen": {
    "maximum_attempts": 5000,
    "screen_notional_usdc": 200,
    "minimum_trades_train": 50,
    "minimum_profit_factor_train": 1.2,
    "minimum_stable_neighbors": 2,
    "cost_scenarios_required": ["base", "conservative", "stress"],
    "future_periods_accessed": false,
    "direction_policy": "each_family_screened_independently_as_both_long_short"
  },
  "sq_generation": {
    "generator": "StrategyQuant",
    "search_method": "genetic_evolution",
    "maximum_attempts": 10000,
    "attempt_stop_guard": 64,
    "accepted_candidates_global_budget": 60,
    "max_rules": 3,
    "genetic_parameters": {
      "crossover_probability_pct": 80,
      "mutation_probability_pct": 20,
      "migration_every_generations": 5,
      "migration_rate_pct": 10,
      "initial_population_mode": 2
    },
    "profile_parameter_ranges": {
      "eurusd_d1_breakout_v4": {
        "indicator_period_min": 20,
        "indicator_period_max": 100,
        "shift_min": 1,
        "shift_max": 2,
        "exit_after_bars_min": 8,
        "exit_after_bars_max": 25,
        "exit_after_bars_step": 1
      },
      "eurusd_d1_momentum_v4": {
        "indicator_period_min": 40,
        "indicator_period_max": 150,
        "shift_min": 1,
        "shift_max": 2,
        "exit_after_bars_min": 10,
        "exit_after_bars_max": 30,
        "exit_after_bars_step": 1,
        "roc_threshold_min": -10,
        "roc_threshold_max": 10,
        "roc_threshold_step": 0.5
      },
      "eurusd_d1_shock_reversion_v4": {
        "indicator_period_min": 2,
        "indicator_period_max": 30,
        "shift_min": 1,
        "shift_max": 2,
        "exit_after_bars_min": 2,
        "exit_after_bars_max": 10,
        "exit_after_bars_step": 1,
        "rsi_threshold_min": 20,
        "rsi_threshold_max": 80,
        "rsi_threshold_step": 5,
        "roc_threshold_min": -5,
        "roc_threshold_max": 5,
        "roc_threshold_step": 0.25
      },
      "us500_d1_time_series_momentum_v4": {
        "indicator_period_min": 60,
        "indicator_period_max": 180,
        "shift_min": 1,
        "shift_max": 2,
        "exit_after_bars_min": 4,
        "exit_after_bars_max": 15,
        "exit_after_bars_step": 1,
        "roc_threshold_min": -15,
        "roc_threshold_max": 15,
        "roc_threshold_step": 0.5
      },
      "us500_d1_shock_reversion_v4": {
        "indicator_period_min": 2,
        "indicator_period_max": 30,
        "shift_min": 1,
        "shift_max": 2,
        "exit_after_bars_min": 2,
        "exit_after_bars_max": 10,
        "exit_after_bars_step": 1,
        "roc_threshold_min": -8,
        "roc_threshold_max": 8,
        "roc_threshold_step": 0.25
      },
      "us500_d1_volatility_regime_trend_v4": {
        "indicator_period_min": 10,
        "indicator_period_max": 150,
        "shift_min": 1,
        "shift_max": 2,
        "exit_after_bars_min": 4,
        "exit_after_bars_max": 15,
        "exit_after_bars_step": 1,
        "roc_threshold_min": -12,
        "roc_threshold_max": 12,
        "roc_threshold_step": 0.5
      }
    },
    "selection_policy": "all_supported_translatable_unique_candidates",
    "calendar_filter_policy": "day_of_week_allowed_but_intraday_hours_forbidden_on_D1",
    "robustness_during_generation": false
  },
  "temporal_validation": {
    "evaluation_notional_usdc": 200,
    "selection_metric": "pareto_net_expectancy_drawdown_window_stability",
    "minimum_trades_oos": 30,
    "minimum_positive_windows_ratio": 0.6,
    "minimum_oos_profit_factor": 1.15,
    "maximum_oos_drawdown_pct": 20,
    "maximum_train_oos_expectancy_decay_pct": 50
  },
  "robustness": {
    "evaluation_notional_usdc": 200,
    "monte_carlo_runs": 1000,
    "monte_carlo_method": "iid_observed_trade_bootstrap_with_replacement",
    "monte_carlo_seed": 20260811,
    "minimum_profitable_monte_carlo_ratio": 0.7,
    "parameter_perturbation_pct": 10,
    "parameter_variant_method": "strategyquant_RandomizeStrategyParameters",
    "parameter_probability_pct": 10,
    "minimum_parameter_variants": 4,
    "minimum_profitable_parameter_variants_ratio": 0.75,
    "cost_stress_multiplier": 2,
    "liquidation_model": "ostium_threshold_cost_buffered",
    "minimum_stress_profit_factor": 1.05,
    "maximum_liquidation_probability": 0.001
  },
  "small_account": {
    "capital_scenarios_usdc": [100, 200, 300, 500, 1000],
    "canonical_capital_usdc": 200,
    "maximum_risk_per_trade_pct": 1.5,
    "maximum_portfolio_margin_pct": 35,
    "minimum_reserve_pct": 40,
    "minimum_net_expectancy_usdc": 0.1,
    "minimum_net_profit_factor": 1.1,
    "minimum_trades": 30,
    "cost_scenarios_required": ["base", "conservative", "stress"],
    "maximum_single_trade_loss_pct": 3.0,
    "candidate_selection_policy": "max_worst_cost_expectancy_then_profit_factor_then_candidate_id",
    "leverage_grid": [1, 2, 3, 5, 8, 10, 15, 20, 30, 50, 75, 100, 150, 200],
    "brokerage_api_max_leverage": 100,
    "leverage_selection_policy": "maximum_safe_in_grid_up_to_venue_limit",
    "required_stop_loss": true,
    "require_observed_venue_minimum_notional": true,
    "liquidation_model": "ostium_threshold_cost_buffered",
    "minimum_stop_to_liquidation_buffer_ratio": 1.5
  },
  "portfolio_construction": {
    "minimum_strategies": 4,
    "maximum_strategies": 8,
    "maximum_candidate_pool": 12,
    "maximum_absolute_daily_stress_pnl_correlation": 0.7,
    "maximum_exit_date_jaccard": 0.8,
    "minimum_union_exit_dates": 30,
    "maximum_concurrent_positions": 2,
    "maximum_concurrent_stop_risk_pct": 3.0,
    "maximum_concurrent_capital_commitment_pct": 60.0,
    "one_candidate_per_directed_hypothesis": true,
    "selection_policy": "maximum_cardinality_then_worst_cost_expectancy_then_profit_factor_then_candidate_ids",
    "holdout_accessed": false
  },
  "final_holdout_validation": {
    "minimum_trades": 20,
    "minimum_profit_factor": 1.1,
    "maximum_drawdown_pct": 20,
    "minimum_net_expectancy_usdc": 0.1,
    "cost_scenarios_required": ["base", "conservative", "stress"],
    "maximum_evaluations": 1
  },
  "parity": {
    "minimum_matched_signals": 30,
    "minimum_matched_trades": 30,
    "minimum_signal_match_rate": 1.0,
    "minimum_trade_match_rate": 1.0,
    "minimum_candle_coverage_pct": 95.0,
    "minimum_pnl_correlation": 0.99,
    "maximum_pnl_mean_absolute_error_usdc": 0.005,
    "maximum_pnl_absolute_error_usdc": 0.01
  },
  "paper_execution": {
    "maximum_quote_age_seconds": 10,
    "maximum_future_clock_skew_seconds": 2,
    "maximum_signal_deviation_fraction_of_initial_stop": 0.25,
    "maximum_live_spread_policy": "stress_variable_roundtrip_bps_envelope",
    "entry_reference_price": "brokerage_service_ostium_mid",
    "require_runtime_risk_at_or_below_signal_budget": true
  },
  "evidence_chain": {
    "hash_algorithm": "sha256",
    "candidate_lineage": "SQ candidate ids may first appear at sq_generation and must then only shrink",
    "promotion_rule": "only PASS may advance; REJECT and BLOCK are terminal",
    "legacy_rule": "legacy_example receipts may prove rejection only and can never advance",
    "artifact_rule": "every receipt hash and referenced artifact hash must verify",
    "holdout_rule": "holdout cannot be accessed before robustness and small-account gates pass",
    "paper_rule": "paper requires exact translation and execution parity receipts"
  }
}
