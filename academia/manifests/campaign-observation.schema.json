{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Alquimia campaign observation",
  "type": "object",
  "required": ["schema_version", "campaign_id", "family", "source_artifacts", "observations", "assessment"],
  "properties": {
    "schema_version": {"const": 1}, "campaign_id": {"type": "string"},
    "family": {"type": "string"},
    "source_artifacts": {"type": "array", "minItems": 1},
    "observations": {"type": "object"},
    "assessment": {
      "type": "object", "required": ["decision", "insight_code", "reason", "next_test", "evidence_status"],
      "properties": {
        "decision": {"enum": ["CONTINUE", "DIRECTED_TEST", "REJECT"]},
        "insight_code": {"type": "string"}, "reason": {"type": "string"},
        "next_test": {"type": "string"}, "evidence_status": {"enum": ["tested", "verified"]}
      }
    }
  }
}
