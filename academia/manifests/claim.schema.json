{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academia claim manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "status", "confidence", "first_seen_at", "updated_at", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["captured", "corroborated", "tested", "verified", "contradicted", "obsolete"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "first_seen_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "locator", "relation"],
        "properties": {
          "source_id": {"type": "string"}, "locator": {"type": "string"},
          "relation": {"enum": ["supports", "contradicts", "mentions"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
